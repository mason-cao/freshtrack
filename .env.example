# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/freshtrack
# Optional per-process pool limit (default 5, maximum 20)
DATABASE_POOL_MAX=5

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Private analytics dashboard (comma-separated Google account emails)
ANALYTICS_ADMIN_EMAILS=
# Optional local-only access when AUTH_DEV_BYPASS=1 (ignored in production)
ANALYTICS_ADMIN_DEV_BYPASS=0
